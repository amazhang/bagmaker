# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit credentials.

# MongoDB connection string. For Atlas, get this from "Connect → Drivers" in the
# Atlas dashboard. Looks like:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bagmaker?retryWrites=true&w=majority
# For local development with a local mongod:
#   mongodb://127.0.0.1:27017/bagmaker
MONGODB_URI=mongodb://127.0.0.1:27017/bagmaker

# Port to listen on. Render sets PORT automatically; locally defaults to 3000.
PORT=3000

# Set to "production" on Render; leave unset (or "development") locally.
# NODE_ENV=development
