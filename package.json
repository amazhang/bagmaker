{
  "name": "bagmaker-node",
  "version": "1.0.0",
  "description": "Bagmaker — a tribute to Huge inc.'s yearly tote bag. Originally built in 2015 as a MEAN-ish stack experiment; modernized in 2026 to run on current Node + MongoDB Atlas.",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node ./bin/www",
    "build": "gulp build",
    "watch": "gulp watch",
    "dev": "concurrently -k -n server,build \"nodemon ./bin/www\" \"gulp watch\"",
    "format": "prettier --write \"**/*.{js,scss,json,pug,md}\"",
    "format:check": "prettier --check \"**/*.{js,scss,json,pug,md}\"",
    "db:clear": "node scripts/clear-db.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "debug": "^4.4.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "pug": "^3.0.3",
    "serve-favicon": "^2.5.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "del": "^6.1.1",
    "gulp": "^5.0.0",
    "gulp-autoprefixer": "^8.0.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-concat": "^2.6.1",
    "gulp-pug": "^5.0.0",
    "gulp-rename": "^2.0.0",
    "gulp-sass": "^5.1.0",
    "gulp-uglify": "^3.0.2",
    "nodemon": "^3.1.7",
    "prettier": "^3.4.2",
    "sass": "^1.81.0"
  },
  "author": "Anthony Zhang"
}
